title: 1D test of RH boundary conditions (3a tests lower humidity)
idfehm
 FEHM3.6_AWH_V_ND_TEST
#hi temp table
eos
table h2o ../input/h2o_props_gaz_6a.txt
table air ../input/air_table_nist23_test.txt
sol
1 -1 
ndar  
1 0 0 1.0d12

end ndar 
pres
    1   0  0 0.2 0.1 2
    1 1 1  0.2 0.1 2
 
ngas  
3
1  0  0  0.01



end ngas
# fdm finite difference grid
fdm
block
50 1 1
0.0 0.0 0.0 
1 1.
-50 1.

1 1.

1 1.

node
bloc
1 1 1

#------------------------------------  BOUN
#test1 input mod 2, mod 3, mod 4, outflow mod 1 K= 1.e-13
#test2 input mod 2, mod 3, mod 4, outflow mod 1 K= 1.e-14
